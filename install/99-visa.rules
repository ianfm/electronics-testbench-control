# /etc/udev/rules.d/99-visa.rules
SUBSYSTEM=="usb", ATTR{idVendor}=="1ab1", GROUP="plugdev", MODE="0660"
SUBSYSTEM=="usb", ATTR{idVendor}=="f4ec", GROUP="plugdev", MODE="0660"
# Keysight/Agilent (e.g. B2902B SMU)
SUBSYSTEM=="usb", ATTR{idVendor}=="2a8d", GROUP="plugdev", MODE="0660"
SUBSYSTEM=="usb", ATTR{idVendor}=="0957", GROUP="plugdev", MODE="0660"
KERNEL=="usbtmc*", GROUP="plugdev", MODE="0660"